      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "tsx scripts/build.ts",
    "build": "tsx scripts/build.ts && vite build",
    "test": "vitest run",
    "example": "vite serve ./example"
  },
  "peerDependencies": {
    "svelte": ">= 5.0"
  },
  "devDependencies": {
    "@dev.icons/codegen": "workspace:*",
    "@dev.icons/utils": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.4",
    "jsdom": "^25.0.1",
    "fast-glob": "3.3.3",
    "prettier": "3.5.3",
    "prettier-plugin-svelte": "^3.3.3",
    "svelte": "^5.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "5.4.1",
    "vitest": "3.1.3"
  }
}
