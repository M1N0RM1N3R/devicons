{
  "name": "@dev.icons/svelte",
  "version": "0.0.0",
  "type": "module",
  "description": "Devicons Svelte - The Svelte package for Devicons",
  "keywords": [],
  "svelte": "./dist/index.mjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
