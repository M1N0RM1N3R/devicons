    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^17.4.7",
    "fast-glob": "3.3.3",
    "prettier": "3.5.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "5.4.1",
    "vitest": "3.1.3",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.8"
  }
