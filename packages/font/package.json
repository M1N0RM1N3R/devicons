{
  "name": "devicons",
  "version": "1.8.0",
  "description": "Devicons - Icon font for developers",
  "type": "module",
  "keywords": [
    "icons",
    "font",
    "webfont",
    "devicons"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./css": "./dist/devicons.css",
    "./woff2": "./dist/devicons.woff2",
    "./ttf": "./dist/devicons.ttf",
    "./sprite": "./dist/sprite-symbol.svg",
    "./codepoints": "./dist/codepoints.json"
  },
  "files": [
    "dist",
    "src",
    "codepoints.lock.json"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@dev.icons/core": "workspace:*",
    "fast-glob": "3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "3.1.3"
  }
}
