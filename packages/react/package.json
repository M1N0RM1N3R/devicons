    "example": "vite serve ./example"
  },
  "peerDependencies": {
    "react": ">= 16.8",
    "react-dom": ">= 16.8"
  },
  "devDependencies": {
    "@dev.icons/codegen": "workspace:*",
    "@dev.icons/utils": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "prettier": "3.5.3",
    "fast-glob": "3.3.3",
    "happy-dom": "^17.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "5.4.1",
    "vitest": "3.1.3",
    "vite-tsconfig-paths": "5.1.4"
  }
}
