---
import type { CollectionEntry } from 'astro:content';
import PageLayout from '../components/layout/page-layout.astro';
import { IconDetail } from '../components/icons/icon-detail';
import Breadcrumbs from '../components/seo/breadcrumbs.astro';
import RelatedIcons from '../components/seo/related-icons.astro';
import { Badge } from '../components/ui/badge';
import { Tag } from '../components/ui/tag';
import {
  breadcrumbSchema,
  iconBrandSchema,
  iconImageSchema,
} from '../lib/seo';
import { getRelatedIcons } from '../lib/related-icons';
import { slugifyTag } from '../lib/icons-query';
import { bucketForHex } from '../lib/colors';

type IconNav = { slug: string; name: string } | null;
type Props = CollectionEntry<'icons'>['data'] & {
  slug: string;
  prev: IconNav;
  next: IconNav;
};

const {
  name,
  description,
  icons,
  tags,
  deprecated,
  version,
  website,
  license,
  mainColor,
  otherColors,
  badInDark,
  badInLight,
  slug,
  prev,
  next,
} = Astro.props;

const contrastHint = badInDark && badInLight
  ? 'Low contrast — preview on a patterned background'
  : badInDark
    ? 'Looks better on a light background'
    : badInLight
      ? 'Looks better on a dark background'
      : null;

const title = `${name} Logo — Free SVG Icon & React Component | Devicons`;
const metaDescription =
  description
    ? `${description} Download the ${name} logo as a free SVG, or use the React, Vue, and Svelte components.`
    : `Download the ${name} logo as an optimized SVG. Free React, Vue, and Svelte components under the MIT license.`;

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Icons', url: '/icons' },
    { name, url: `/icons/${slug}` },
  ]),
  iconBrandSchema({ name, description, slug, website, mainColor }),
  iconImageSchema({ name, slug, license }),
];

const colorChips = [
  mainColor ? { hex: mainColor, label: 'Primary' } : null,
  ...(otherColors ?? []).map((hex: string) => ({ hex, label: 'Secondary' })),
].filter((c): c is { hex: string; label: string } => c !== null);

const related = await getRelatedIcons(slug, tags, 8);
---

<PageLayout
  title={title}
  description={metaDescription}
  image={`/og/icons/${slug}.png`}
  jsonLd={jsonLd}
  brand={name}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-6 sm:pt-10">
    <Breadcrumbs
      items={[
        { name: 'Home', url: '/' },
        { name: 'Icons', url: '/icons' },
        { name },
      ]}
    />

    <header class="mt-6 mb-6 sm:mb-8">
      <h1 class="type-display-sm">{name}</h1>
      {
        description && (
          <p class="type-body-lg mt-3 max-w-[64ch]">{description}</p>
        )
      }

      <div class="flex items-center gap-2 mt-3 sm:mt-4 flex-wrap">
        {deprecated && <Badge variant="destructive">Deprecated</Badge>}
        {version && <Badge variant="neutral">v{version}</Badge>}
        <Badge variant="success">
          {icons.length} variant{icons.length > 1 ? 's' : ''}
        </Badge>
        {
          website && (
            <a
              href={website}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-xs font-semibold uppercase tracking-caps leading-none text-accent hover:text-accent-hover transition-colors break-all">
              {website.replace(/^https?:\/\//, '').replace(/\/$/, '')}
            </a>
          )
        }
        {
          colorChips.map(({ hex, label }) => {
            const bucket = bucketForHex(hex);
            const chipClass =
              'inline-flex items-center gap-1.5 font-mono text-xs font-semibold uppercase tracking-caps leading-none text-text-muted hover:text-accent transition-colors';
            const swatch = (
              <span
                aria-hidden="true"
                class="inline-block w-3 h-3 border border-border shrink-0"
                style={`background-color: ${hex}`}
              />
            );
            const hexText = hex.toUpperCase();
            return bucket ? (
              <a
                href={`/icons/color/${bucket}`}
                aria-label={`${label} brand color ${hexText}`}
                class={chipClass}>
                {swatch}
                {hexText}
              </a>
            ) : (
              <span
                aria-label={`${label} brand color ${hexText}`}
                class={chipClass}>
                {swatch}
                {hexText}
              </span>
            );
          })
        }
      </div>

      {
        tags.length > 0 && (
          <div class="flex gap-2 mt-3 sm:mt-4 flex-wrap">
            {tags.map((tag: string) => (
              <Tag href={`/icons/tag/${slugifyTag(tag)}`}>{tag}</Tag>
            ))}
          </div>
        )
      }
    </header>
  </div>

  {
    contrastHint && (
      <p class="max-w-4xl mx-auto px-4 sm:px-6 mb-3 font-mono text-[10px] font-semibold uppercase tracking-caps leading-none text-text-muted flex items-center gap-2">
        <span aria-hidden="true" class="inline-block w-2 h-2 bg-accent" />
        {contrastHint}
      </p>
    )
  }

  <IconDetail
    client:idle
    name={name}
    icons={icons}
    slug={slug}
    badInDark={badInDark}
    badInLight={badInLight}
  />

  <section class="max-w-4xl mx-auto px-4 sm:px-6 mt-12 sm:mt-16 pb-8 sm:pb-12">
    <RelatedIcons icons={related} />

    {
      (prev || next) && (
        <nav
          aria-label="Icon navigation"
          class="mt-12 sm:mt-16 pt-6 sm:pt-8 border-t border-border grid grid-cols-2 gap-3 sm:gap-4">
          {prev ? (
            <a
              href={`/icons/${prev.slug}`}
              data-astro-prefetch
              class="group flex flex-col gap-2 p-4 border border-border hover:border-accent/60 transition-colors">
              <span class="type-meta group-hover:text-accent transition-colors">
                Previous
              </span>
              <span class="type-h3 truncate">{prev.name}</span>
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a
              href={`/icons/${next.slug}`}
              data-astro-prefetch
              class="group flex flex-col gap-2 p-4 border border-border hover:border-accent/60 transition-colors text-right sm:col-start-2">
              <span class="type-meta group-hover:text-accent transition-colors">
                Next
              </span>
              <span class="type-h3 truncate">{next.name}</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </section>
</PageLayout>
