---
import PageLayout from "../components/layout/page-layout.astro";
import Breadcrumbs from "../components/seo/breadcrumbs.astro";
import { SearchIsland } from "../components/search/search-island";
import { getActiveIcons } from "../lib/icons-query";
import { SITE_TITLE } from "../consts";
import { breadcrumbSchema, collectionPageSchema } from "../lib/seo";

const icons = await getActiveIcons();

const title = `Search ${icons.length}+ developer icons — SVG, React, Vue, Svelte | ${SITE_TITLE}`;
const description = `Search the Devicons library of ${icons.length} developer logos. Find any brand, framework, database, or cloud provider — download as SVG or use as a React, Vue, Svelte, or Astro component.`;

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Search", url: "/search" },
  ]),
  collectionPageSchema({
    name: "Search developer icons",
    description,
    url: "/search",
    items: icons
      .slice(0, 100)
      .map((i) => ({ name: i.data.name, url: `/icons/${i.id}` })),
  }),
];
---

<PageLayout title={title} description={description} image="/og/search.png" jsonLd={jsonLd}>
  <div class="max-w-[1400px] mx-auto px-6 pt-10">
    <Breadcrumbs
      items={[
        { name: "Home", url: "/" },
        { name: "Search" },
      ]}
    />
    <header class="mt-6 mb-8 pb-8 border-b border-border">
      <p class="type-label mb-4 flex items-center gap-3">
        <span aria-hidden="true" class="inline-block w-3 h-[2px] bg-accent"></span>
        {icons.length} icons
      </p>
      <h1 class="type-h1">Search developer icons</h1>
      <p class="type-body-lg mt-3 max-w-[64ch]">
        Find any brand, framework, database, or cloud provider in the Devicons
        library. Free SVGs plus React, Vue, Svelte, and Astro components — MIT
        licensed.
      </p>
    </header>
  </div>
  <SearchIsland client:only="react" />
</PageLayout>
