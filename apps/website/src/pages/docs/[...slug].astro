---
import { render } from 'astro:content';
import { getSortedDocs } from '../../lib/docs';
import Docs from '../../layouts/Docs.astro';
import {
  faqSchema,
  howToSchema,
  softwarePackageSchema,
} from '../../lib/seo';

export async function getStaticPaths() {
  const INDEX_ID = 'introduction';
  const docs = await getSortedDocs();
  return docs.map(entry => ({
    params: { slug: entry.id === INDEX_ID ? undefined : entry.id },
    props: { entry, isIndex: entry.id === INDEX_ID },
  }));
}

const { entry, isIndex } = Astro.props;
const { Content, headings } = await render(entry);

const DOC_FAQS: Record<string, Array<{ question: string; answer: string }>> = {
  installation: [
    {
      question: 'How do I install Devicons in a React project?',
      answer:
        "Run `npm install @dev.icons/react`. Then import an icon component, e.g. `import { React } from '@dev.icons/react'`.",
    },
    {
      question: 'Does Devicons work with Vue and Svelte?',
      answer:
        'Yes. Install the matching package — `@dev.icons/vue` or `@dev.icons/svelte` — and import components the same way.',
    },
    {
      question: 'Can I use raw SVG files instead of components?',
      answer:
        'Yes. Every icon is available as an optimized SVG; download directly from the icon page or the Devicons GitHub repository.',
    },
    {
      question: 'What license are Devicons released under?',
      answer:
        'Devicons is released under the MIT license. Brand assets remain the property of their respective owners.',
    },
  ],
};

const extraBlocks: Array<Record<string, unknown>> = [];

if (DOC_FAQS[entry.id]) extraBlocks.push(faqSchema(DOC_FAQS[entry.id]));

if (entry.id === 'installation') {
  extraBlocks.push(
    howToSchema({
      name: 'Install Devicons',
      description: 'Install the Devicons package for your framework of choice.',
      url: '/docs/installation',
      totalTime: 'PT2M',
      steps: [
        {
          name: 'Pick your package',
          text: 'Choose the Devicons package matching your framework: @dev.icons/react, @dev.icons/vue, @dev.icons/svelte, or @dev.icons/astro. For plain SVG or a web font, you can also use @dev.icons/core.',
        },
        {
          name: 'Install with your package manager',
          text: 'Run `npm install @dev.icons/react` (or the Vue/Svelte/Astro variant) inside your project. pnpm and yarn work identically.',
        },
        {
          name: 'Import and render an icon',
          text: 'Import any named icon component and render it with a `size` prop: `import { ReactIcon } from "@dev.icons/react"; <ReactIcon size={32} />`.',
        },
      ],
    }),
  );
}

if (entry.id === 'quick-start') {
  extraBlocks.push(
    howToSchema({
      name: 'Quick start with Devicons',
      description:
        'Drop a first Devicons icon into your app end-to-end in under two minutes.',
      url: '/docs/quick-start',
      totalTime: 'PT2M',
      steps: [
        {
          name: 'Install the package for your framework',
          text: 'Run `npm install @dev.icons/react` (substitute vue/svelte/astro as needed).',
        },
        {
          name: 'Import an icon by name',
          text: 'Components use PascalCase: `react` → `ReactIcon`, `next-js` → `NextJsIcon`.',
        },
        {
          name: 'Render with a size prop',
          text: '`<ReactIcon size={32} />` renders a 32×32 SVG that inherits `currentColor` in the monochrome variant.',
        },
      ],
    }),
  );
}

const FRAMEWORK_PACKAGES: Record<
  string,
  { packageName: string; runtime: string }
> = {
  react: { packageName: '@dev.icons/react', runtime: 'React' },
  vue: { packageName: '@dev.icons/vue', runtime: 'Vue' },
  svelte: { packageName: '@dev.icons/svelte', runtime: 'Svelte' },
  astro: { packageName: '@dev.icons/astro', runtime: 'Astro' },
  'icon-font': { packageName: '@dev.icons/core', runtime: 'Web Font' },
};

const fwPkg = FRAMEWORK_PACKAGES[entry.id];
if (fwPkg) {
  extraBlocks.push(
    softwarePackageSchema({
      name: `${fwPkg.packageName} — Devicons for ${fwPkg.runtime}`,
      description: entry.data.description,
      url: `/docs/${entry.id}`,
      packageName: fwPkg.packageName,
      runtime: fwPkg.runtime,
    }),
  );
}

const extraJsonLd = extraBlocks.length > 0 ? extraBlocks : undefined;
---

<Docs
  id={entry.id}
  title={entry.data.title}
  description={entry.data.description}
  badge={entry.data.badge}
  category={entry.data.category}
  headings={headings}
  isIndex={isIndex}
  extraJsonLd={extraJsonLd}>
  <Content />
</Docs>
