---
import { render } from "astro:content";
import { getSortedDocs } from "../../lib/docs";
import Docs from "../../layouts/Docs.astro";

export async function getStaticPaths() {
  const INDEX_ID = "introduction";
  const docs = await getSortedDocs();
  return docs.map((entry) => ({
    params: { slug: entry.id === INDEX_ID ? undefined : entry.id },
    props: { entry, isIndex: entry.id === INDEX_ID },
  }));
}

const { entry, isIndex } = Astro.props;
const { Content, headings } = await render(entry);
---

<Docs
  id={entry.id}
  title={entry.data.title}
  description={entry.data.description}
  badge={entry.data.badge}
  headings={headings}
  isIndex={isIndex}
>
  <Content />
</Docs>
