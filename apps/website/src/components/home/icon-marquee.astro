---
/*
  Brutalist marquee: single infinite row of popular icons on monochrome
  slab tiles, separated by 1px dividers. Mono labels + numeric index.
  Hover pauses; per-tile hover flips to accent. Full-bleed, hard edges.
*/

const ICONS = [
  { file: 'vite', label: 'Vite' },
  { file: 'typescript-icon', label: 'TypeScript' },
  { file: 'nextjs-icon', label: 'Next.js' },
  { file: 'nodejs-icon', label: 'Node.js' },
  { file: 'python', label: 'Python' },
  { file: 'docker-icon', label: 'Docker' },
  { file: 'visual-studio-code', label: 'VS Code' },
  { file: 'javascript', label: 'JavaScript' },
  { file: 'claude-code', label: 'Claude Code' },
  { file: 'chrome', label: 'Chrome' },
];

// Duplicate the row so the translate-50% loop is seamless.
const TRACK = [...ICONS, ...ICONS];
---

<section class="marquee" aria-label="Popular icons included in the package">
  <div class="marquee__frame">
    <div class="marquee__track" data-marquee-track>
      {
        TRACK.map((icon, i) => (
          <div class="marquee__tile" aria-hidden={i >= ICONS.length}>
            <span class="marquee__index type-mono">
              {String((i % ICONS.length) + 1).padStart(2, '0')}
            </span>
            <img
              class="marquee__icon"
              src={`/devicons/icons/${icon.file}.svg`}
              alt={icon.label}
              loading="lazy"
              decoding="async"
              width="56"
              height="56"
            />
            <span class="marquee__label type-mono">{icon.label}</span>
            <button
              type="button"
              class="marquee__copy copy-btn"
              aria-label={`Copy ${icon.label} SVG`}
              data-svg-src={`/devicons/icons/${icon.file}.svg`}
            >SVG</button>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .marquee {
    position: relative;
    border-top: 1px solid var(--c-border);
    border-bottom: 1px solid var(--c-border);
    background: var(--c-bg);
    overflow: hidden;
    isolation: isolate;
  }

  /* Accent slab behind everything — a hard-edged ribbon so the eye
     catches the marquee as a distinct brutalist stripe. */
  .marquee::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 77, 0, 0.04) 30%,
      rgba(255, 77, 0, 0.04) 70%,
      transparent 100%
    );
    pointer-events: none;
    z-index: 0;
  }

  .marquee__frame {
    position: relative;
    z-index: 1;
    display: flex;
    width: 100%;
    overflow: hidden;
  }

  .marquee__frame::before,
  .marquee__frame::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 48px;
    z-index: 2;
    pointer-events: none;
  }

  .marquee__frame::before {
    left: 0;
    background: linear-gradient(90deg, var(--c-bg), transparent);
  }

  .marquee__frame::after {
    right: 0;
    background: linear-gradient(270deg, var(--c-bg), transparent);
  }

  .marquee__track {
    display: flex;
    flex: 0 0 auto;
    width: max-content;
    animation: scroll-infinite 60s linear infinite;
    will-change: transform;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__tile {
    flex: 0 0 auto;
    width: 130px;
    height: 100px;
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    align-items: center;
    justify-items: center;
    padding: 10px 12px;
    border: 1px solid var(--c-border);
    margin-left: -1px;
    background: var(--c-bg);
    color: var(--c-text);
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .marquee__tile:hover {
    background: color-mix(in oklab, var(--c-accent) 4%, var(--c-bg));
    border-color: var(--c-accent);
    z-index: 1;
  }

  /* Copy button — revealed on tile hover, top-right corner. */
  .marquee__copy {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 3;
    min-width: 40px;
    height: 24px;
    font-size: 9px;
    opacity: 0;
    transition:
      opacity 0.15s ease,
      color 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .marquee__tile:hover .marquee__copy {
    opacity: 1;
  }

  .marquee__index {
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-caps);
    color: var(--c-text-muted);
    align-self: start;
    justify-self: start;
    line-height: 1;
  }

  .marquee__icon {
    width: 40px;
    height: 40px;
    object-fit: contain;
    display: block;
    position: relative;
    z-index: 2;
    transition: transform 0.15s ease;
  }

  .marquee__tile:hover .marquee__icon {
    transform: scale(1.05);
  }

  .marquee__label {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--c-text-secondary);
    align-self: end;
    justify-self: start;
    line-height: 1;
  }

  @media (min-width: 768px) {
    .marquee__tile {
      width: 220px;
      height: 160px;
      padding: 14px 16px;
    }
    .marquee__icon {
      width: 64px;
      height: 64px;
    }
  }

  /* Hide copy button on small screens — tiles are too compact. */
  @media (max-width: 767px) {
    .marquee__copy {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>

<script>
  const svgCache = new Map<string, string>();

  document.querySelectorAll<HTMLButtonElement>('.marquee__copy').forEach((btn) => {
    const src = btn.dataset.svgSrc;
    if (!src) return;

    let resetId: number | undefined;

    btn.addEventListener('click', async (e) => {
      e.stopPropagation();

      try {
        let svg = svgCache.get(src);
        if (!svg) {
          const res = await fetch(src);
          if (!res.ok) throw new Error(`${res.status}`);
          svg = await res.text();
          svgCache.set(src, svg);
        }

        await navigator.clipboard.writeText(svg);
        btn.dataset.state = 'copied';
        btn.textContent = 'OK';
        if (resetId) window.clearTimeout(resetId);
        resetId = window.setTimeout(() => {
          delete btn.dataset.state;
          btn.textContent = 'SVG';
        }, 1500);
      } catch {
        btn.textContent = 'ERR';
        if (resetId) window.clearTimeout(resetId);
        resetId = window.setTimeout(() => {
          btn.textContent = 'SVG';
        }, 1500);
      }
    });
  });
</script>
