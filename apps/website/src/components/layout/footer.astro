---
const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="footer-brand-mark" aria-hidden="true"></div>

  <div class="max-w-[1400px] mx-auto px-6 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 py-12 border-t border-border">
      <div>
        <p class="type-label mb-3">
          Links
        </p>
        <div class="flex flex-col gap-2">
          <a
            href="https://github.com/nicholasgasior/devicons"
            class="type-body-sm hover:text-accent transition-colors"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
          <a
            href="https://www.npmjs.com/package/@devicons/react"
            class="type-body-sm hover:text-accent transition-colors"
            target="_blank"
            rel="noopener noreferrer"
          >
            npm
          </a>
          <a
            href="/docs"
            class="type-body-sm hover:text-accent transition-colors"
          >
            Documentation
          </a>
          <a
            href="/legal"
            class="type-body-sm hover:text-accent transition-colors"
          >
            Legal
          </a>
        </div>
      </div>

      <div>
        <p class="type-label mb-3">
          Project
        </p>
        <p class="type-body-sm">
          Open source. Crisp and clear icons for developers.
        </p>
        <p class="type-body-sm text-text-muted mt-2">{year} Devicons</p>
        <div class="mt-3">
          <button
            type="button"
            data-theme-toggle
            aria-label="Toggle theme"
            class="theme-toggle"
          >
            <span class="theme-toggle__option" data-theme-opt="dark">
              <span class="theme-toggle__swatch theme-toggle__swatch--dark" aria-hidden="true"></span>
              <span>DARK</span>
            </span>
            <span class="theme-toggle__sep" aria-hidden="true">/</span>
            <span class="theme-toggle__option" data-theme-opt="light">
              <span class="theme-toggle__swatch theme-toggle__swatch--light" aria-hidden="true"></span>
              <span>LIGHT</span>
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-brand-mark {
    position: relative;
    padding: 4rem 0;
    overflow: hidden;
    user-select: none;
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0;
    border: 1px solid var(--c-border);
    background: var(--c-surface);
    padding: 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--c-text-muted);
    transition: border-color 0.15s ease;
  }

  .theme-toggle:hover {
    border-color: var(--c-accent);
  }

  .theme-toggle__option {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .theme-toggle__option[data-active] {
    color: var(--c-accent);
    background: color-mix(in oklab, var(--c-accent) 8%, transparent);
  }

  .theme-toggle__sep {
    color: var(--c-border);
    padding: 0;
    font-weight: 400;
  }

  .theme-toggle__swatch {
    display: inline-block;
    width: 8px;
    height: 8px;
    border: 1px solid var(--c-border);
    flex-shrink: 0;
  }

  .theme-toggle__swatch--dark {
    background: #000;
  }

  .theme-toggle__swatch--light {
    background: #fff;
  }

  .footer-brand-mark::before {
    content: "DEVICONS";
    display: block;
    width: 100%;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 900;
    line-height: 1;
    font-size: clamp(6rem, 20vw, 28rem);
    letter-spacing: -0.06em;
    color: var(--c-text);
    opacity: 0.04;
  }
</style>

<script>
  function initThemeToggle() {
    const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
    const optDark = document.querySelector<HTMLElement>('[data-theme-opt="dark"]');
    const optLight = document.querySelector<HTMLElement>('[data-theme-opt="light"]');

    function applyTheme(theme: "light" | "dark") {
      if (theme === "light") {
        document.documentElement.setAttribute("data-theme", "light");
      } else {
        document.documentElement.removeAttribute("data-theme");
      }
      if (optDark && optLight) {
        if (theme === "dark") {
          optDark.setAttribute("data-active", "");
          optLight.removeAttribute("data-active");
        } else {
          optLight.setAttribute("data-active", "");
          optDark.removeAttribute("data-active");
        }
      }
    }

    const initial = (localStorage.getItem("theme") as "light" | "dark" | null) === "light" ? "light" : "dark";
    applyTheme(initial);

    btn?.addEventListener("click", () => {
      const current = localStorage.getItem("theme") === "light" ? "light" : "dark";
      const next = current === "dark" ? "light" : "dark";
      localStorage.setItem("theme", next);
      applyTheme(next);
    });
  }

  document.addEventListener("astro:page-load", initThemeToggle);
</script>
