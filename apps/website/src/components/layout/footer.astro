---
const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="footer-brand-mark" aria-hidden="true"></div>

  <div class="max-w-[1400px] mx-auto px-6 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 py-12 border-t border-border">
      <div>
        <p class="type-label mb-3">
          Links
        </p>
        <div class="flex flex-col gap-2">
          <a
            href="https://github.com/nicholasgasior/devicons"
            class="type-body-sm hover:text-text transition-colors"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
          <a
            href="https://www.npmjs.com/package/@devicons/react"
            class="type-body-sm hover:text-text transition-colors"
            target="_blank"
            rel="noopener noreferrer"
          >
            npm
          </a>
          <a
            href="/docs"
            class="type-body-sm hover:text-text transition-colors"
          >
            Documentation
          </a>
        </div>
      </div>

      <div>
        <p class="type-label mb-3">
          Project
        </p>
        <p class="type-body-sm">
          Open source. Crisp and clear icons for developers.
        </p>
        <p class="type-body-sm text-text-muted mt-2">{year} Devicons</p>
        <div class="mt-3">
          <button
            type="button"
            data-theme-toggle
            aria-label="Toggle theme"
            class="type-body-sm flex items-center gap-2 text-text-muted hover:text-text transition-colors cursor-pointer"
          >
            <svg data-sun width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
              <circle cx="12" cy="12" r="5" />
              <line x1="12" y1="1" x2="12" y2="3" />
              <line x1="12" y1="21" x2="12" y2="23" />
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
              <line x1="1" y1="12" x2="3" y2="12" />
              <line x1="21" y1="12" x2="23" y2="12" />
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
            </svg>
            <svg data-moon width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true" class="hidden">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
            <span class="type-mono-sm" data-theme-label>Light</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-brand-mark {
    position: relative;
    padding: 4rem 0;
    overflow: hidden;
    user-select: none;
  }
  .footer-brand-mark::before {
    content: "DEVICONS";
    display: block;
    width: 100%;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 900;
    line-height: 1;
    font-size: clamp(6rem, 20vw, 28rem);
    letter-spacing: -0.06em;
    color: var(--c-text);
    opacity: 0.07;
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const sun = document.querySelector<HTMLElement>("[data-sun]");
  const moon = document.querySelector<HTMLElement>("[data-moon]");
  const label = document.querySelector<HTMLElement>("[data-theme-label]");

  function applyTheme(theme: "light" | "dark") {
    if (theme === "light") {
      document.documentElement.setAttribute("data-theme", "light");
    } else {
      document.documentElement.removeAttribute("data-theme");
    }
    if (sun && moon && label) {
      sun.classList.toggle("hidden", theme === "light");
      moon.classList.toggle("hidden", theme === "dark");
      label.textContent = theme === "dark" ? "Light" : "Dark";
    }
  }

  const initial = (localStorage.getItem("theme") as "light" | "dark" | null) === "light" ? "light" : "dark";
  applyTheme(initial);

  btn?.addEventListener("click", () => {
    const current = localStorage.getItem("theme") === "light" ? "light" : "dark";
    const next = current === "dark" ? "light" : "dark";
    localStorage.setItem("theme", next);
    applyTheme(next);
  });
</script>
