---
import DocsSidebar from './docs-sidebar.astro';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
---

<div
  class="docs-nav-topbar sticky top-14 z-40 px-0 py-4 bg-bg border-b border-border flex items-center justify-between gap-4">
  <div class="type-label flex items-center gap-3">
    <span aria-hidden="true" class="inline-block w-3 h-[2px] bg-accent"></span>
    Documentation
  </div>
  <button
    type="button"
    data-docs-nav-trigger
    aria-label="Open documentation menu"
    aria-controls="docs-mobile-nav"
    aria-expanded="false"
    class="btn btn--ghost btn--mono btn--sm">
    <svg
      width="14"
      height="14"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      class="shrink-0"
      aria-hidden="true">
      <line x1="2" y1="4" x2="14" y2="4"></line>
      <line x1="2" y1="8" x2="14" y2="8"></line>
      <line x1="2" y1="12" x2="14" y2="12"></line>
    </svg>
    <span>Docs Menu</span>
  </button>
</div>

<div
  id="docs-mobile-nav"
  data-docs-nav
  data-state="closed"
  aria-hidden="true"
  class="docs-nav">
  <div data-docs-nav-overlay class="docs-nav__overlay"></div>

  <aside
    role="dialog"
    aria-modal="true"
    aria-label="Documentation navigation"
    data-docs-nav-panel
    class="docs-nav__panel bg-bg border-r border-border flex flex-col">
    <div
      class="h-14 flex items-center justify-between px-4 border-b border-border shrink-0">
      <div class="type-label flex items-center gap-3">
        <span aria-hidden="true" class="inline-block w-3 h-[2px] bg-accent"
        ></span>
        Documentation
      </div>
      <button
        type="button"
        data-docs-nav-close
        aria-label="Close documentation menu"
        class="inline-flex items-center justify-center w-9 h-9 border border-border bg-surface text-text hover:border-accent hover:text-accent transition-colors">
        <svg
          width="14"
          height="14"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true">
          <line x1="3" y1="3" x2="13" y2="13"></line>
          <line x1="13" y1="3" x2="3" y2="13"></line>
        </svg>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto px-4 py-2">
      <DocsSidebar currentSlug={currentSlug} compact />
    </div>
  </aside>
</div>

<script>
  import { setupMobileMenu } from '../../lib/mobile-menu';
  setupMobileMenu({
    key: 'docs-nav',
    breakpoint: '(min-width: 768px)',
    closeOnPanelLinkClick: true,
  });
</script>
