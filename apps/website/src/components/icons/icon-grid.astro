---
export interface IconGridItem {
  slug: string;
  name: string;
  iconFile: string;
}

interface Props {
  items: IconGridItem[];
  emptyMessage?: string;
}

const { items, emptyMessage = "No icons found." } = Astro.props;
---

{items.length === 0 ? (
  <p class="type-body text-text-muted">{emptyMessage}</p>
) : (
  <ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
    {items.map((icon) => (
      <li>
        <a
          href={`/icons/${icon.slug}`}
          data-astro-prefetch
          class="flex flex-col items-center gap-2 p-4 border border-border hover:border-accent/60 transition-colors group aspect-square justify-center"
        >
          <img
            src={`/devicons/icons/${icon.iconFile}.svg`}
            alt={`${icon.name} logo`}
            width="48"
            height="48"
            loading="lazy"
            decoding="async"
            class="w-12 h-12 object-contain"
          />
          <span class="type-mono text-[10px] uppercase tracking-wider truncate w-full text-center text-text-muted group-hover:text-accent transition-colors">
            {icon.name}
          </span>
        </a>
      </li>
    ))}
  </ul>
)}
